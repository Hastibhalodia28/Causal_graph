    {
      "@id": "urn:kpi-analysis:21809844ecd6ad2c93fb25bea80b4d480f35e67beb7477da4d6b4461407f5fe4:dimension:0",
      "@type": "rec:Dimension",
      "rec:position": 0,
      "name": "customer acquisition",
      "description": "Evaluates the effectiveness of strategies to attract new paying customers, which directly contributes to revenue growth."
    },
    {
      "@id": "urn:kpi-analysis:21809844ecd6ad2c93fb25bea80b4d480f35e67beb7477da4d6b4461407f5fe4:dimension:1",
      "@type": "rec:Dimension",
      "rec:position": 1,
      "name": "purchase frequency",
      "description": "Measures how often existing customers make purchases; increasing frequency without new customers grows revenue."
    },
    {
      "@id": "urn:kpi-analysis:21809844ecd6ad2c93fb25bea80b4d480f35e67beb7477da4d6b4461407f5fe4:dimension:2",
      "@type": "rec:Dimension",
      "rec:position": 2,
      "name": "basket value",
      "description": "Assesses the monetary value of each transaction; increasing the amount spent per purchase directly increases revenue."
    },
    {
      "@id": "urn:kpi-analysis:21809844ecd6ad2c93fb25bea80b4d480f35e67beb7477da4d6b4461407f5fe4:dimension:3",
      "@type": "rec:Dimension",
      "rec:position": 3,
      "name": "customer retention",
      "description": "Examines the ability to keep existing customers over time, as retained customers provide recurring revenue."
    },
    {
      "@id": "urn:kpi-analysis:21809844ecd6ad2c93fb25bea80b4d480f35e67beb7477da4d6b4461407f5fe4:dimension:4",
      "@type": "rec:Dimension",
      "rec:position": 4,
      "name": "pricing structure",
      "description": "Investigates the setup of prices, discounts, and tiers, as changes here can directly impact revenue per unit sold."
    },
    {
      "@id": "urn:kpi-analysis:21809844ecd6ad2c93fb25bea80b4d480f35e67beb7477da4d6b4461407f5fe4:dimension:5",
      "@type": "rec:Dimension",
      "rec:position": 5,
      "name": "sales channel performance",
      "description": "Compares the contribution of different avenues (e.g., online, in-store, partner) to overall revenue generation."
    },
    {
      "@id": "urn:kpi-analysis:21809844ecd6ad2c93fb25bea80b4d480f35e67beb7477da4d6b4461407f5fe4:dimension:6",
