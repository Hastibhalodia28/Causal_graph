      "@id": "kpi:DELIVERY_DAYS",
      "@type": [
        "kpi:KPI",
        "rec:RecommendedKPI"
      ],
      "name": "DELIVERY_DAYS",
      "description": "Delivery Days. Collected from Olist source columns. Computed as (order_delivered_customer_date - order_purchase_timestamp) / 86400, by order_id. Unit: Days.",
      "rec:position": 0,
      "rec:relevance": 3,
      "rec:forDimension": [
        {
          "@id": "urn:kpi-analysis:872932fa1f4d8b2b402365722ef847a7f74615faaef3a8059e24c34e0e74b066:dimension:2"
        },
        {
          "@id": "urn:kpi-analysis:872932fa1f4d8b2b402365722ef847a7f74615faaef3a8059e24c34e0e74b066:dimension:6"
        }
      ],
      "rec:dimensionLabels": {
        "@value": [
          "fulfillment timeline",
          "geographic location"
        ],
        "@type": "@json"
      },
      "rec:recommendationEvidence": [
        {
          "@type": "rec:RecommendationEvidence",
          "rec:forDimension": [
            {
              "@id": "urn:kpi-analysis:872932fa1f4d8b2b402365722ef847a7f74615faaef3a8059e24c34e0e74b066:dimension:2"
            }
          ],
          "rec:dimensionLabel": "fulfillment timeline",
          "rec:reason": "Directly measures the total time from order placement to customer delivery, encompassing the entire fulfillment timeline. Long delivery times are a primary reason for order cancellations."
        },
        {
          "@type": "rec:RecommendationEvidence",
          "rec:forDimension": [
            {
              "@id": "urn:kpi-analysis:872932fa1f4d8b2b402365722ef847a7f74615faaef3a8059e24c34e0e74b066:dimension:6"
            }
          ],
          "rec:dimensionLabel": "geographic location",
          "rec:reason": "Directly measures delivery timelines which vary by geographic location and impact cancellation decisions"
        }
      ],
      "rec:evidenceName": "DELIVERY_DAYS",
      "sector": {
        "@id": "sector:delivery"
      },
      "formula": {
        "expression": "(order_delivered_customer_date - order_purchase_timestamp) / 86400, by order_id"
      },
