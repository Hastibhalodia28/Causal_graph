    {
      "@id": "kpi:DELAY_DAYS",
      "@type": [
        "kpi:KPI",
        "rec:RecommendedKPI"
      ],
      "name": "DELAY_DAYS",
      "description": "Delay Days. Collected from Olist source columns. Computed as calendar_days(order_delivered_customer_date) - calendar_days(order_estimated_delivery_date), by order_id. Unit: Days.",
      "rec:position": 1,
      "rec:relevance": 3,
      "rec:forDimension": [
        {
          "@id": "urn:kpi-analysis:872932fa1f4d8b2b402365722ef847a7f74615faaef3a8059e24c34e0e74b066:dimension:2"
        },
        {
          "@id": "urn:kpi-analysis:872932fa1f4d8b2b402365722ef847a7f74615faaef3a8059e24c34e0e74b066:dimension:6"
        }
      ],
      "rec:dimensionLabels": {
        "@value": [
          "fulfillment timeline",
          "geographic location"
        ],
        "@type": "@json"
      },
      "rec:recommendationEvidence": [
        {
          "@type": "rec:RecommendationEvidence",
          "rec:forDimension": [
            {
              "@id": "urn:kpi-analysis:872932fa1f4d8b2b402365722ef847a7f74615faaef3a8059e24c34e0e74b066:dimension:2"
            }
          ],
          "rec:dimensionLabel": "fulfillment timeline",
          "rec:reason": "Meets estimated delivery dates is a key customer expectation. Significant delays (positive values) are strong diagnostic evidence for why an order might be cancelled, though it measures the outcome rather than the timeline itself."
        },
        {
          "@type": "rec:RecommendationEvidence",
          "rec:forDimension": [
            {
              "@id": "urn:kpi-analysis:872932fa1f4d8b2b402365722ef847a7f74615faaef3a8059e24c34e0e74b066:dimension:6"
            }
          ],
          "rec:dimensionLabel": "geographic location",
          "rec:reason": "Directly measures delivery performance against estimates, which varies by region and influences cancellation behavior"
        }
      ],
      "rec:evidenceName": "DELAY_DAYS",
      "sector": {
        "@id": "sector:delivery"
      },
      "formula": {
        "expression": "calendar_days(order_delivered_customer_date) - calendar_days(order_estimated_delivery_date), by order_id"
      },
