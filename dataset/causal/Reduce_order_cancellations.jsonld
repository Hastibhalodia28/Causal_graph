      "@type": "rec:Goal",
      "rec:objective": "improve",
      "rec:target": "order cancellations",
      "rec:domain": "e-commerce/order fulfillment",
      "rec:needsDecomposition": true
    },
    {
      "@id": "urn:kpi-analysis:872932fa1f4d8b2b402365722ef847a7f74615faaef3a8059e24c34e0e74b066",
      "@type": "rec:KPIAnalysis",
      "rec:query": "Reduce order cancellations",
      "rec:summary": "The KPIs evaluate order cancellation reduction by measuring fulfillment timeline performance (DELIVERY_DAYS, DELAY_DAYS, APPROVAL_HOURS, PROCESSING_DAYS, SHIP_LIMIT_MET, IS_ON_TIME), geographic location variations (DELIVERY_DAYS, DELAY_DAYS, FREIGHT_RATIO, IS_ON_TIME), and customer service interactions (HAS_COMMENT, IS_NEGATIVE_REVIEW). They provide direct measurement and diagnostic evidence across these dimensions to identify potential factors associated with cancellation decisions.",
      "rec:hasDimension": [
        {
          "@id": "urn:kpi-analysis:872932fa1f4d8b2b402365722ef847a7f74615faaef3a8059e24c34e0e74b066:dimension:0"
        },
        {
