      "rec:position": 0,
      "name": "customer profile",
      "description": "Understanding customer segments (e.g., new vs. returning, demographics) can reveal patterns in cancellation behavior."
    },
    {
      "@id": "urn:kpi-analysis:872932fa1f4d8b2b402365722ef847a7f74615faaef3a8059e24c34e0e74b066:dimension:1",
      "@type": "rec:Dimension",
      "rec:position": 1,
      "name": "order characteristics",
      "description": "Attributes like product category, basket size, and number of items may influence cancellation likelihood."
    },
    {
      "@id": "urn:kpi-analysis:872932fa1f4d8b2b402365722ef847a7f74615faaef3a8059e24c34e0e74b066:dimension:2",
      "@type": "rec:Dimension",
      "rec:position": 2,
      "name": "fulfillment timeline",
      "description": "The time between order placement, confirmation, and shipping can be a significant driver of cancellations."
    },
    {
      "@id": "urn:kpi-analysis:872932fa1f4d8b2b402365722ef847a7f74615faaef3a8059e24c34e0e74b066:dimension:3",
      "@type": "rec:Dimension",
      "rec:position": 3,
      "name": "customer service interactions",
      "description": "Inquiries, complaints, or support requests related to an order often precede a cancellation."
    },
    {
      "@id": "urn:kpi-analysis:872932fa1f4d8b2b402365722ef847a7f74615faaef3a8059e24c34e0e74b066:dimension:4",
      "@type": "rec:Dimension",
      "rec:position": 4,
      "name": "payment method",
      "description": "The chosen payment type (e.g., credit card, PayPal) can affect transaction success and subsequent cancellations."
    },
    {
      "@id": "urn:kpi-analysis:872932fa1f4d8b2b402365722ef847a7f74615faaef3a8059e24c34e0e74b066:dimension:5",
      "@type": "rec:Dimension",
      "rec:position": 5,
      "name": "promotional context",
      "description": "Orders placed during sales or using discount codes may have different cancellation rates."
    },
