  "@graph": [
    {
      "@id": "urn:kpi-analysis:015f3bdc232732076f5ed1ca7a2d8debb93ef431c385cb37c8045b8166bc72c8:dimension:0",
      "@type": "rec:Dimension",
      "rec:position": 0,
      "name": "shipping distance",
      "description": "The physical distance a package travels is a primary driver of cost, as it directly impacts fuel consumption, labor hours, and carrier zone charges."
    },
    {
      "@id": "urn:kpi-analysis:015f3bdc232732076f5ed1ca7a2d8debb93ef431c385cb37c8045b8166bc72c8:dimension:1",
      "@type": "rec:Dimension",
      "rec:position": 1,
      "name": "package dimensions",
      "description": "The size and volumetric weight of a package determine the space it occupies in a vehicle, which affects shipping rates and the number of packages that can be transported per trip."
    },
    {
      "@id": "urn:kpi-analysis:015f3bdc232732076f5ed1ca7a2d8debb93ef431c385cb37c8045b8166bc72c8:dimension:2",
      "@type": "rec:Dimension",
      "rec:position": 2,
      "name": "package weight",
      "description": "The actual weight of a package is a fundamental factor in cost calculations for most carriers, as heavier items require more fuel and handling effort to transport."
    },
    {
      "@id": "urn:kpi-analysis:015f3bdc232732076f5ed1ca7a2d8debb93ef431c385cb37c8045b8166bc72c8:dimension:3",
      "@type": "rec:Dimension",
      "rec:position": 3,
      "name": "shipping speed",
      "description": "The level of service (e.g., next-day, standard ground) chosen has a significant cost implication, with expedited options being substantially more expensive than standard delivery."
    },
    {
      "@id": "urn:kpi-analysis:015f3bdc232732076f5ed1ca7a2d8debb93ef431c385cb37c8045b8166bc72c8:dimension:4",
      "@type": "rec:Dimension",
      "rec:position": 4,
      "name": "carrier selection",
      "description": "Different carriers (e.g., national postal service, regional providers, private companies) have varying rate structures, discounts, and surcharges for the same service."
    },
    {
      "@id": "urn:kpi-analysis:015f3bdc232732076f5ed1ca7a2d8debb93ef431c385cb37c8045b8166bc72c8:dimension:5",
      "@type": "rec:Dimension",
      "rec:position": 5,
      "name": "shipping origin and destination type",
      "description": "Costs differ based on whether a shipment is going to a residential or commercial address, and whether it is originating from a warehouse, store, or a third-party fulfillment center."
    },
    {
      "@id": "urn:kpi-analysis:015f3bdc232732076f5ed1ca7a2d8debb93ef431c385cb37c8045b8166bc72c8:dimension:6",
      "@type": "rec:Dimension",
      "rec:position": 6,
      "name": "order consolidation",
      "description": "The practice of combining multiple items from a single order into one shipment, or combining multiple orders for the same destination, can reduce the number of individual packages and lower per-shipment costs."
    },
    {
      "@id": "urn:kpi-analysis:015f3bdc232732076f5ed1ca7a2d8debb93ef431c385cb37c8045b8166bc72c8:dimension:7",
      "@type": "rec:Dimension",
      "rec:position": 7,
      "name": "packaging material",
      "description": "The type and amount of material used (e.g., box, poly mailer, dunnage) contribute to the total weight and size of the shipment and incur a material cost."
    },
    {
      "@id": "urn:kpi-analysis:015f3bdc232732076f5ed1ca7a2d8debb93ef431c385cb37c8045b8166bc72c8:goal",
      "@type": "rec:Goal",
      "rec:objective": "reduce",
      "rec:target": "shipping costs",
      "rec:domain": "logistics/supply chain/e-commerce",
      "rec:needsDecomposition": true
    },
    {
      "@id": "urn:kpi-analysis:015f3bdc232732076f5ed1ca7a2d8debb93ef431c385cb37c8045b8166bc72c8",
      "@type": "rec:KPIAnalysis",
      "rec:query": "reduce shipping costs",
      "rec:summary": "The KPIs provide diagnostic evidence for evaluating shipping cost reduction across multiple dimensions. PRODUCT_VOLUME_CM3 measures package dimensions and packaging material requirements, which are primary factors in dimensional weight pricing. DELIVERY_DAYS directly measures shipping speed service levels. FREIGHT_RATIO evaluates shipping costs relative to product value across shipping distance, package dimensions, carrier selection, and order consolidation efficiency. DELAY_DAYS and IS_ON_TIME provide evidence about shipping performance and service level adherence, which relates to cost-efficient service selection.",
      "rec:hasDimension": [
        {
          "@id": "urn:kpi-analysis:015f3bdc232732076f5ed1ca7a2d8debb93ef431c385cb37c8045b8166bc72c8:dimension:0"
        },
        {
          "@id": "urn:kpi-analysis:015f3bdc232732076f5ed1ca7a2d8debb93ef431c385cb37c8045b8166bc72c8:dimension:1"
        },
        {
          "@id": "urn:kpi-analysis:015f3bdc232732076f5ed1ca7a2d8debb93ef431c385cb37c8045b8166bc72c8:dimension:2"
        },
        {
          "@id": "urn:kpi-analysis:015f3bdc232732076f5ed1ca7a2d8debb93ef431c385cb37c8045b8166bc72c8:dimension:3"
        },
        {
          "@id": "urn:kpi-analysis:015f3bdc232732076f5ed1ca7a2d8debb93ef431c385cb37c8045b8166bc72c8:dimension:4"
        },
        {
          "@id": "urn:kpi-analysis:015f3bdc232732076f5ed1ca7a2d8debb93ef431c385cb37c8045b8166bc72c8:dimension:5"
        },
        {
          "@id": "urn:kpi-analysis:015f3bdc232732076f5ed1ca7a2d8debb93ef431c385cb37c8045b8166bc72c8:dimension:6"
        },
        {
          "@id": "urn:kpi-analysis:015f3bdc232732076f5ed1ca7a2d8debb93ef431c385cb37c8045b8166bc72c8:dimension:7"
        }
      ],
      "rec:recommends": [
        {
          "@id": "kpi:PRODUCT_VOLUME_CM3"
        },
        {
          "@id": "kpi:DELIVERY_DAYS"
        },
        {
          "@id": "kpi:FREIGHT_RATIO"
        },
        {
          "@id": "kpi:DELAY_DAYS"
        },
        {
          "@id": "kpi:IS_ON_TIME"
        }
      ],
      "rec:goal": {
        "@id": "urn:kpi-analysis:015f3bdc232732076f5ed1ca7a2d8debb93ef431c385cb37c8045b8166bc72c8:goal"
      }
    },
    {
