    {
      "@id": "kpi:PRODUCT_VOLUME_CM3",
      "@type": [
        "kpi:KPI",
        "rec:RecommendedKPI"
      ],
      "name": "PRODUCT_VOLUME_CM3",
      "description": "Product Volume Cm3. Collected from Olist source columns. Computed as mean(product_length_cm * product_height_cm * product_width_cm) over the products in the order, by order_id. Unit: Cubic centimetres.",
      "rec:position": 0,
      "rec:relevance": 3,
      "rec:forDimension": [
        {
          "@id": "urn:kpi-analysis:015f3bdc232732076f5ed1ca7a2d8debb93ef431c385cb37c8045b8166bc72c8:dimension:1"
        },
        {
          "@id": "urn:kpi-analysis:015f3bdc232732076f5ed1ca7a2d8debb93ef431c385cb37c8045b8166bc72c8:dimension:7"
        }
      ],
      "rec:dimensionLabels": {
        "@value": [
          "package dimensions",
          "packaging material"
        ],
        "@type": "@json"
      },
      "rec:recommendationEvidence": [
        {
          "@type": "rec:RecommendationEvidence",
          "rec:forDimension": [
            {
              "@id": "urn:kpi-analysis:015f3bdc232732076f5ed1ca7a2d8debb93ef431c385cb37c8045b8166bc72c8:dimension:1"
            }
          ],
          "rec:dimensionLabel": "package dimensions",
          "rec:reason": "Directly measures the volumetric size of products in an order, which is a primary factor in determining shipping costs based on package dimensions."
        },
        {
          "@type": "rec:RecommendationEvidence",
          "rec:forDimension": [
            {
              "@id": "urn:kpi-analysis:015f3bdc232732076f5ed1ca7a2d8debb93ef431c385cb37c8045b8166bc72c8:dimension:7"
            }
          ],
          "rec:dimensionLabel": "packaging material",
          "rec:reason": "Product volume is a strong diagnostic indicator for packaging material requirements. Larger product volumes typically require larger boxes and more dunnage material, which directly increases both material costs and shipping weight/dimensional weight costs."
        }
      ],
      "rec:evidenceName": "PRODUCT_VOLUME_CM3",
      "sector": {
        "@id": "sector:product"
      },
      "formula": {
        "expression": "mean(product_length_cm * product_height_cm * product_width_cm) over the products in the order, by order_id"
      },
