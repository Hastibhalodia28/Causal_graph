      "@id": "kpi:DELIVERY_DAYS",
      "@type": [
        "kpi:KPI",
        "rec:RecommendedKPI"
      ],
      "name": "DELIVERY_DAYS",
      "description": "Delivery Days. Collected from Olist source columns. Computed as (order_delivered_customer_date - order_purchase_timestamp) / 86400, by order_id. Unit: Days.",
      "rec:position": 1,
      "rec:relevance": 3,
      "rec:forDimension": [
        {
          "@id": "urn:kpi-analysis:015f3bdc232732076f5ed1ca7a2d8debb93ef431c385cb37c8045b8166bc72c8:dimension:3"
        }
      ],
      "rec:dimensionLabels": {
