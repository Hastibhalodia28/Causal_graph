              "@id": "urn:kpi-analysis:015f3bdc232732076f5ed1ca7a2d8debb93ef431c385cb37c8045b8166bc72c8:dimension:3"
            }
          ],
          "rec:dimensionLabel": "shipping speed",
          "rec:reason": "Directly measures shipping speed by calculating the total time from purchase to delivery, which directly corresponds to the level of service chosen and its cost implications."
        }
      ],
      "rec:evidenceName": "DELIVERY_DAYS",
      "sector": {
        "@id": "sector:delivery"
      },
      "formula": {
