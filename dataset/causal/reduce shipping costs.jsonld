    {
      "@id": "sector:payments",
      "@type": "kpi:Sector",
      "name": "Payments"
    },
    {
      "@id": "kpi:FREIGHT_RATIO",
      "@type": [
        "kpi:KPI",
        "rec:RecommendedKPI"
      ],
      "name": "FREIGHT_RATIO",
      "description": "Freight Ratio. Collected from Olist source columns. Computed as sum(freight_value) / sum(price), by order_id. Unit: Ratio.",
      "rec:position": 2,
      "rec:relevance": 2,
      "rec:forDimension": [
        {
          "@id": "urn:kpi-analysis:015f3bdc232732076f5ed1ca7a2d8debb93ef431c385cb37c8045b8166bc72c8:dimension:0"
        },
        {
          "@id": "urn:kpi-analysis:015f3bdc232732076f5ed1ca7a2d8debb93ef431c385cb37c8045b8166bc72c8:dimension:1"
        },
        {
          "@id": "urn:kpi-analysis:015f3bdc232732076f5ed1ca7a2d8debb93ef431c385cb37c8045b8166bc72c8:dimension:4"
        },
        {
          "@id": "urn:kpi-analysis:015f3bdc232732076f5ed1ca7a2d8debb93ef431c385cb37c8045b8166bc72c8:dimension:6"
        }
      ],
      "rec:dimensionLabels": {
        "@value": [
          "shipping distance",
          "package dimensions",
          "carrier selection",
          "order consolidation"
        ],
        "@type": "@json"
      },
      "rec:recommendationEvidence": [
        {
          "@type": "rec:RecommendationEvidence",
          "rec:forDimension": [
            {
              "@id": "urn:kpi-analysis:015f3bdc232732076f5ed1ca7a2d8debb93ef431c385cb37c8045b8166bc72c8:dimension:0"
            }
          ],
          "rec:dimensionLabel": "shipping distance",
          "rec:reason": "While not directly measuring shipping distance, freight costs are strongly correlated with distance traveled. A high freight ratio indicates higher shipping costs relative to product value, which often results from longer shipping distances. This provides strong diagnostic evidence for evaluating the impact of shipping distance on overall costs."
        },
        {
          "@type": "rec:RecommendationEvidence",
          "rec:forDimension": [
            {
              "@id": "urn:kpi-analysis:015f3bdc232732076f5ed1ca7a2d8debb93ef431c385cb37c8045b8166bc72c8:dimension:1"
            }
          ],
          "rec:dimensionLabel": "package dimensions",
          "rec:reason": "Provides strong diagnostic evidence as it shows the relationship between freight costs and product price, which can be influenced by package dimensions (larger/heavier packages typically have higher freight costs)."
        },
        {
          "@type": "rec:RecommendationEvidence",
          "rec:forDimension": [
            {
              "@id": "urn:kpi-analysis:015f3bdc232732076f5ed1ca7a2d8debb93ef431c385cb37c8045b8166bc72c8:dimension:4"
            }
          ],
          "rec:dimensionLabel": "carrier selection",
          "rec:reason": "The freight ratio (freight cost divided by product price) provides strong diagnostic evidence for carrier selection. Different carriers have varying rate structures and surcharges, which directly impact the freight value. A high ratio may indicate inefficient carrier selection, while a low ratio suggests cost-effective shipping choices. This KPI doesn't directly measure carrier selection but strongly indicates its effectiveness in controlling shipping costs."
        },
        {
          "@type": "rec:RecommendationEvidence",
          "rec:forDimension": [
            {
              "@id": "urn:kpi-analysis:015f3bdc232732076f5ed1ca7a2d8debb93ef431c385cb37c8045b8166bc72c8:dimension:6"
            }
          ],
          "rec:dimensionLabel": "order consolidation",
          "rec:reason": "While not a direct measure of consolidation, the freight ratio (freight cost relative to order value) provides strong diagnostic evidence. Effective order consolidation should lower the freight ratio by reducing per-shipment costs relative to the total order value."
        }
      ],
      "rec:evidenceName": "FREIGHT_RATIO",
      "sector": {
