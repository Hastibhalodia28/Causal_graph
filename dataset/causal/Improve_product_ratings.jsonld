  "@graph": [
    {
      "@id": "urn:kpi-analysis:659d03f79b794cc79bd6a401aa1ea3d0ffabbaaede0bbfa9dd308bef4b4c76a7:dimension:0",
      "@type": "rec:Dimension",
      "rec:position": 0,
      "name": "Product quality and features",
      "description": "Investigates if the product's physical attributes, durability, performance, or included features meet customer expectations, which is a primary driver of satisfaction and ratings."
    },
    {
      "@id": "urn:kpi-analysis:659d03f79b794cc79bd6a401aa1ea3d0ffabbaaede0bbfa9dd308bef4b4c76a7:dimension:1",
      "@type": "rec:Dimension",
      "rec:position": 1,
      "name": "Value for money",
      "description": "Examines the perceived balance between the product's price and the benefits it provides, as customers who feel overcharged are likely to leave poor ratings."
    },
    {
      "@id": "urn:kpi-analysis:659d03f79b794cc79bd6a401aa1ea3d0ffabbaaede0bbfa9dd308bef4b4c76a7:dimension:2",
      "@type": "rec:Dimension",
      "rec:position": 2,
      "name": "Customer support experience",
      "description": "Evaluates the quality of pre-sale and post-sale support interactions, including response time and problem resolution, which heavily influences customer sentiment and subsequent ratings."
    },
    {
      "@id": "urn:kpi-analysis:659d03f79b794cc79bd6a401aa1ea3d0ffabbaaede0bbfa9dd308bef4b4c76a7:dimension:3",
      "@type": "rec:Dimension",
      "rec:position": 3,
      "name": "Delivery and fulfillment process",
      "description": "Assesses the speed of delivery, condition of the product upon arrival, and accuracy of the order, as failures here often lead to negative reviews unrelated to the product itself."
    },
    {
      "@id": "urn:kpi-analysis:659d03f79b794cc79bd6a401aa1ea3d0ffabbaaede0bbfa9dd308bef4b4c76a7:dimension:4",
      "@type": "rec:Dimension",
      "rec:position": 4,
      "name": "Ease of use and setup",
      "description": "Focuses on the user experience from unboxing to initial operation; a difficult or confusing process can frustrate users and result in lower ratings."
    },
    {
      "@id": "urn:kpi-analysis:659d03f79b794cc79bd6a401aa1ea3d0ffabbaaede0bbfa9dd308bef4b4c76a7:dimension:5",
      "@type": "rec:Dimension",
      "rec:position": 5,
      "name": "Accuracy of product description and imagery",
      "description": "Looks at whether the product received matches what was advertised on the website in terms of appearance, size, and functionality, a common source of negative feedback."
    },
    {
      "@id": "urn:kpi-analysis:659d03f79b794cc79bd6a401aa1ea3d0ffabbaaede0bbfa9dd308bef4b4c76a7:dimension:6",
      "@type": "rec:Dimension",
      "rec:position": 6,
      "name": "Rating distribution and review content",
      "description": "Analyzes the spread of ratings (e.g., 1-star vs. 5-star) and the specific themes, complaints, or praises mentioned within the text of written reviews to identify actionable patterns."
    },
    {
      "@id": "urn:kpi-analysis:659d03f79b794cc79bd6a401aa1ea3d0ffabbaaede0bbfa9dd308bef4b4c76a7:goal",
      "@type": "rec:Goal",
      "rec:objective": "improve",
      "rec:target": "product ratings",
      "rec:domain": "e-commerce or product-based business",
      "rec:needsDecomposition": true
    },
    {
      "@id": "urn:kpi-analysis:659d03f79b794cc79bd6a401aa1ea3d0ffabbaaede0bbfa9dd308bef4b4c76a7",
      "@type": "rec:KPIAnalysis",
      "rec:query": "Improve product ratings",
      "rec:summary": "The KPIs provide comprehensive measurement across key dimensions that influence product ratings. REVIEW_SCORE and IS_NEGATIVE_REVIEW directly measure customer satisfaction outcomes across product quality, support experience, description accuracy, and rating distribution. DELIVERY_DAYS, DELAY_DAYS, and IS_ON_TIME evaluate delivery performance and timeliness. HAS_COMMENT provides qualitative insights from written feedback, while SHIP_LIMIT_MET and PROCESSING_DAYS assess seller fulfillment efficiency. PHOTOS_QTY evaluates product presentation quality that may influence setup experience. Together, these KPIs enable monitoring of both the ultimate rating outcomes and the operational factors that contribute to customer satisfaction.",
      "rec:hasDimension": [
        {
          "@id": "urn:kpi-analysis:659d03f79b794cc79bd6a401aa1ea3d0ffabbaaede0bbfa9dd308bef4b4c76a7:dimension:0"
        },
        {
          "@id": "urn:kpi-analysis:659d03f79b794cc79bd6a401aa1ea3d0ffabbaaede0bbfa9dd308bef4b4c76a7:dimension:1"
        },
        {
          "@id": "urn:kpi-analysis:659d03f79b794cc79bd6a401aa1ea3d0ffabbaaede0bbfa9dd308bef4b4c76a7:dimension:2"
        },
        {
          "@id": "urn:kpi-analysis:659d03f79b794cc79bd6a401aa1ea3d0ffabbaaede0bbfa9dd308bef4b4c76a7:dimension:3"
        },
        {
          "@id": "urn:kpi-analysis:659d03f79b794cc79bd6a401aa1ea3d0ffabbaaede0bbfa9dd308bef4b4c76a7:dimension:4"
        },
        {
          "@id": "urn:kpi-analysis:659d03f79b794cc79bd6a401aa1ea3d0ffabbaaede0bbfa9dd308bef4b4c76a7:dimension:5"
        },
        {
          "@id": "urn:kpi-analysis:659d03f79b794cc79bd6a401aa1ea3d0ffabbaaede0bbfa9dd308bef4b4c76a7:dimension:6"
        }
      ],
      "rec:recommends": [
        {
          "@id": "kpi:REVIEW_SCORE"
        },
        {
          "@id": "kpi:IS_NEGATIVE_REVIEW"
        },
        {
          "@id": "kpi:DELIVERY_DAYS"
        },
        {
          "@id": "kpi:DELAY_DAYS"
        },
        {
          "@id": "kpi:IS_ON_TIME"
        },
        {
          "@id": "kpi:HAS_COMMENT"
        },
        {
          "@id": "kpi:SHIP_LIMIT_MET"
        },
        {
          "@id": "kpi:PROCESSING_DAYS"
        },
        {
          "@id": "kpi:PHOTOS_QTY"
        },
        {
          "@id": "kpi:PRODUCT_WEIGHT_G"
        }
      ],
      "rec:goal": {
        "@id": "urn:kpi-analysis:659d03f79b794cc79bd6a401aa1ea3d0ffabbaaede0bbfa9dd308bef4b4c76a7:goal"
      },
      "rec:target": {
        "@id": "kpi:REVIEW_SCORE"
      }
    },
