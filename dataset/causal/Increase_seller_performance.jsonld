        },
        {
          "@id": "urn:kpi-analysis:803d0cdaf61708ddfb5010eb8ebf6bfdfba92a39a04d5048bd51449d37b7d2af:dimension:7"
        },
        {
          "@id": "urn:kpi-analysis:803d0cdaf61708ddfb5010eb8ebf6bfdfba92a39a04d5048bd51449d37b7d2af:dimension:9"
        }
      ],
      "rec:dimensionLabels": {
        "@value": [
          "customer feedback",
          "customer support responsiveness",
          "return and refund handling",
          "product listing quality",
          "seller growth and scalability"
        ],
        "@type": "@json"
      },
      "rec:recommendationEvidence": [
        {
          "@type": "rec:RecommendationEvidence",
          "rec:forDimension": [
            {
              "@id": "urn:kpi-analysis:803d0cdaf61708ddfb5010eb8ebf6bfdfba92a39a04d5048bd51449d37b7d2af:dimension:1"
            }
          ],
          "rec:dimensionLabel": "customer feedback",
          "rec:reason": "Directly measures customer perception of product and service quality through explicit 1-5 star ratings, which is the core of customer feedback."
        },
        {
          "@type": "rec:RecommendationEvidence",
          "rec:forDimension": [
            {
              "@id": "urn:kpi-analysis:803d0cdaf61708ddfb5010eb8ebf6bfdfba92a39a04d5048bd51449d37b7d2af:dimension:5"
            }
          ],
          "rec:dimensionLabel": "customer support responsiveness",
          "rec:reason": "Review scores can provide strong diagnostic evidence about customer support responsiveness, as poor support experiences often result in lower review scores, though they are not a direct measure of response speed or effectiveness."
        },
        {
          "@type": "rec:RecommendationEvidence",
          "rec:forDimension": [
            {
              "@id": "urn:kpi-analysis:803d0cdaf61708ddfb5010eb8ebf6bfdfba92a39a04d5048bd51449d37b7d2af:dimension:6"
            }
          ],
          "rec:dimensionLabel": "return and refund handling",
          "rec:reason": "While not a direct measure of return/refund handling, review scores are strongly influenced by how well sellers handle post-purchase issues like returns and refunds. Low scores often indicate poor resolution of customer problems."
        },
        {
          "@type": "rec:RecommendationEvidence",
          "rec:forDimension": [
            {
              "@id": "urn:kpi-analysis:803d0cdaf61708ddfb5010eb8ebf6bfdfba92a39a04d5048bd51449d37b7d2af:dimension:7"
            }
          ],
          "rec:dimensionLabel": "product listing quality",
          "rec:reason": "Strong diagnostic evidence - poor listing quality often leads to negative reviews due to mismatched expectations."
        },
        {
          "@type": "rec:RecommendationEvidence",
          "rec:forDimension": [
            {
              "@id": "urn:kpi-analysis:803d0cdaf61708ddfb5010eb8ebf6bfdfba92a39a04d5048bd51449d37b7d2af:dimension:9"
            }
          ],
          "rec:dimensionLabel": "seller growth and scalability",
          "rec:reason": "Directly measures service quality, which is essential for maintaining performance during growth and expansion. Poor reviews indicate degradation that would hinder scalability."
        }
      ],
      "rec:evidenceName": "REVIEW_SCORE",
      "sector": {
        "@id": "sector:reviews"
      },
      "formula": {
        "expression": "review_score (1-5), by order_id (mean if multiple review rows per order)"
      },
