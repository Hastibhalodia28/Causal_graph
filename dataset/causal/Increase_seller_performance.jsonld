    {
      "@id": "kpi:REVIEW_SCORE",
      "@type": [
        "kpi:KPI",
        "rec:RecommendedKPI"
      ],
      "name": "REVIEW_SCORE",
      "description": "Review Score. Collected from Olist source columns. Computed as review_score (1-5), by order_id (mean if multiple review rows per order). Unit: Score.",
      "rec:position": 0,
      "rec:relevance": 3,
      "rec:forDimension": [
        {
          "@id": "urn:kpi-analysis:803d0cdaf61708ddfb5010eb8ebf6bfdfba92a39a04d5048bd51449d37b7d2af:dimension:1"
        },
        {
          "@id": "urn:kpi-analysis:803d0cdaf61708ddfb5010eb8ebf6bfdfba92a39a04d5048bd51449d37b7d2af:dimension:5"
