        },
        {
          "@id": "urn:kpi-analysis:803d0cdaf61708ddfb5010eb8ebf6bfdfba92a39a04d5048bd51449d37b7d2af:dimension:3"
        },
        {
          "@id": "urn:kpi-analysis:803d0cdaf61708ddfb5010eb8ebf6bfdfba92a39a04d5048bd51449d37b7d2af:dimension:4"
        },
        {
          "@id": "urn:kpi-analysis:803d0cdaf61708ddfb5010eb8ebf6bfdfba92a39a04d5048bd51449d37b7d2af:dimension:5"
