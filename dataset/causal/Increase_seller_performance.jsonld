    {
      "@id": "urn:kpi-analysis:803d0cdaf61708ddfb5010eb8ebf6bfdfba92a39a04d5048bd51449d37b7d2af:dimension:0",
      "@type": "rec:Dimension",
      "rec:position": 0,
      "name": "order fulfillment",
      "description": "Evaluates the seller's ability to process, pack, and ship orders correctly and on time, which directly impacts customer satisfaction and operational reliability."
    },
    {
      "@id": "urn:kpi-analysis:803d0cdaf61708ddfb5010eb8ebf6bfdfba92a39a04d5048bd51449d37b7d2af:dimension:1",
      "@type": "rec:Dimension",
      "rec:position": 1,
      "name": "customer feedback",
      "description": "Measures the quality of the seller's products and service as perceived by buyers through ratings, reviews, and direct complaints, indicating reputation and trustworthiness."
    },
    {
      "@id": "urn:kpi-analysis:803d0cdaf61708ddfb5010eb8ebf6bfdfba92a39a04d5048bd51449d37b7d2af:dimension:2",
      "@type": "rec:Dimension",
      "rec:position": 2,
      "name": "inventory management",
      "description": "Assesses the seller's effectiveness in maintaining stock levels, avoiding stockouts or overstocking, which affects sales opportunities and capital efficiency."
    },
    {
      "@id": "urn:kpi-analysis:803d0cdaf61708ddfb5010eb8ebf6bfdfba92a39a04d5048bd51449d37b7d2af:dimension:3",
      "@type": "rec:Dimension",
      "rec:position": 3,
      "name": "sales conversion",
      "description": "Examines the seller's ability to turn buyer interest (e.g., product views, inquiries) into actual purchases, reflecting effectiveness in listing quality and customer engagement."
    },
    {
      "@id": "urn:kpi-analysis:803d0cdaf61708ddfb5010eb8ebf6bfdfba92a39a04d5048bd51449d37b7d2af:dimension:4",
      "@type": "rec:Dimension",
      "rec:position": 4,
      "name": "policy compliance",
      "description": "Evaluates adherence to marketplace rules, return policies, and legal requirements, which is critical for maintaining selling privileges and avoiding penalties."
    },
    {
      "@id": "urn:kpi-analysis:803d0cdaf61708ddfb5010eb8ebf6bfdfba92a39a04d5048bd51449d37b7d2af:dimension:5",
      "@type": "rec:Dimension",
      "rec:position": 5,
      "name": "customer support responsiveness",
      "description": "Measures the speed and effectiveness in responding to pre-sale questions and post-sale issues, impacting buyer trust and conflict resolution."
    },
    {
      "@id": "urn:kpi-analysis:803d0cdaf61708ddfb5010eb8ebf6bfdfba92a39a04d5048bd51449d37b7d2af:dimension:6",
      "@type": "rec:Dimension",
      "rec:position": 6,
      "name": "return and refund handling",
      "description": "Assesses how efficiently and fairly the seller manages returns, refunds, and disputes, which influences customer loyalty and operational costs."
    },
    {
      "@id": "urn:kpi-analysis:803d0cdaf61708ddfb5010eb8ebf6bfdfba92a39a04d5048bd51449d37b7d2af:dimension:7",
      "@type": "rec:Dimension",
      "rec:position": 7,
      "name": "product listing quality",
      "description": "Evaluates the accuracy, completeness, and appeal of product descriptions, images, and specifications, which drives discoverability and purchase decisions."
    },
    {
      "@id": "urn:kpi-analysis:803d0cdaf61708ddfb5010eb8ebf6bfdfba92a39a04d5048bd51449d37b7d2af:dimension:8",
      "@type": "rec:Dimension",
      "rec:position": 8,
      "name": "shipping and delivery cost efficiency",
      "description": "Examines the competitiveness and rationality of shipping prices and delivery options offered, affecting buyer attraction and cost management."
    },
    {
      "@id": "urn:kpi-analysis:803d0cdaf61708ddfb5010eb8ebf6bfdfba92a39a04d5048bd51449d37b7d2af:dimension:9",
      "@type": "rec:Dimension",
      "rec:position": 9,
      "name": "seller growth and scalability",
      "description": "Assesses the ability to increase sales volume, expand product range, and enter new markets without degrading service quality, indicating long-term viability."
    },
    {
      "@id": "urn:kpi-analysis:803d0cdaf61708ddfb5010eb8ebf6bfdfba92a39a04d5048bd51449d37b7d2af:goal",
      "@type": "rec:Goal",
      "rec:objective": "improve",
      "rec:target": "seller performance",
      "rec:domain": "e-commerce, marketplace, or sales",
      "rec:needsDecomposition": true
    },
    {
      "@id": "urn:kpi-analysis:803d0cdaf61708ddfb5010eb8ebf6bfdfba92a39a04d5048bd51449d37b7d2af",
      "@type": "rec:KPIAnalysis",
      "rec:query": "Increase seller performance",
      "rec:summary": "The KPIs provide a comprehensive evaluation framework for seller performance across multiple dimensions. REVIEW_SCORE and IS_NEGATIVE_REVIEW directly measure customer feedback quality and identify negative experiences, while also serving as diagnostic indicators for customer support, return handling, and listing quality. SHIP_LIMIT_MET and PROCESSING_DAYS assess order fulfillment efficiency and policy compliance. PHOTOS_QTY and DESCRIPTION_LENGTH evaluate product listing completeness and visual appeal. FREIGHT_RATIO and PRODUCT_VOLUME_CM3 measure shipping cost efficiency and volumetric rationality. DELAY_DAYS and IS_ON_TIME track delivery performance timeliness. HAS_COMMENT captures detailed customer feedback through written comments. Together, these metrics enable monitoring of operational efficiency, service quality, cost management, and customer satisfaction aspects essential for seller performance improvement.",
      "rec:hasDimension": [
        {
          "@id": "urn:kpi-analysis:803d0cdaf61708ddfb5010eb8ebf6bfdfba92a39a04d5048bd51449d37b7d2af:dimension:0"
        },
